{"trace_id":"fad07a49bb17b4710f9849830a2959e8","span_id":"8e57ec76c708e650","parent_span_id":"0fcf2f1b5a3f8f72","name":"litellm_request","attributes":{"gen_ai.cost.discount_amount":0,"gen_ai.cost.discount_percent":0,"gen_ai.cost.input_cost":0,"gen_ai.cost.margin_fixed_amount":0,"gen_ai.cost.margin_percent":0,"gen_ai.cost.margin_total_amount":0,"gen_ai.cost.original_cost":0,"gen_ai.cost.output_cost":0,"gen_ai.cost.tool_usage_cost":0,"gen_ai.cost.total_cost":0,"gen_ai.input.messages":"[{\"role\": \"system\", \"parts\": [{\"type\": \"text\", \"content\": \"You name chat sessions. Given the user's opening message, write a title that lets them find this conversation again in a list.\\n\\nRules:\\n- 3 to 7 words, sentence case (capitalize only the first word and proper nouns).\\n- Name what the user wants DONE, not that they asked a question.\\n- Keep technical terms, filenames, numbers, and error codes exact.\\n- Drop filler words: the, this, my, a, an.\\n- No trailing punctuation, no quotes, no tool names, no 'Title:' prefix.\\n- Never answer the message. Name it.\\n- Always produce something, even for a bare greeting.\\n- Write the title in the same language as the user's message.\\nGood: {\\\"title\\\": \\\"Fix login button on mobile\\\"}\\nGood: {\\\"title\\\": \\\"Postgres connection pool exhaustion\\\"}\\nGood: {\\\"title\\\": \\\"Friendly greeting\\\"}\\nToo vague: {\\\"title\\\": \\\"Code changes\\\"}\\nToo long: {\\\"title\\\": \\\"Investigate and fix the issue where the login button does not respond on mobile devices\\\"}\\n\\nReply with JSON only: {\\\"title\\\": \\\"...\\\"}\"}]}, {\"role\": \"user\", \"parts\": [{\"type\": \"text\", \"content\": \"Reply with exactly: HERMES-THROUGH-GATEWAY-OK\"}]}]","gen_ai.operation.name":"acompletion","gen_ai.output.messages":"[{\"role\": \"assistant\", \"parts\": [{\"type\": \"text\", \"content\": \"{\\\"title\\\": \\\"Hermes Through Gateway Ok\\\"}\"}], \"finish_reason\": \"stop\"}]","gen_ai.request.model":"Qwen3-8B-128K