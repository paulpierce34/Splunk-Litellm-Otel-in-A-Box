{"trace_id":"7579d2309b7b908a271a3eba804f8142","span_id":"141127ced928bd1e","parent_span_id":"a8be42803dcb89e8","name":"raw_gen_ai_request","attributes":{"llm.openai.choices":"[{'finish_reason': 'stop', 'index': 0, 'message': {'content': '{\"title\": \"User Attribution Test Ok\"}', 'role': 'assistant'}}]","llm.openai.created":1795142781,"llm.openai.extra_body":"{}","llm.openai.id":"chatcmpl-RAboMB3lmMRSz7OJdv8Euo8x3a4AhdVh","llm.openai.messages":"[{'role': 'system', 'content': 'You name chat sessions. Given the user\\'s opening message, write a title that lets them find this conversation again in a list.\\n\\nRules:\\n- 3 to 7 words, sentence case (capitalize only the first word and proper nouns).\\n- Name what the user wants DONE, not that they asked a question.\\n- Keep technical terms, filenames, numbers, and error codes exact.\\n- Drop filler words: the, this, my, a, an.\\n- No trailing punctuation, no quotes, no tool names, no \\'Title:\\' prefix.\\n- Never answer the message. Name it.\\n- Always produce something, even for a bare greeting.\\n- Write the title in the same language as the user\\'s message.\\nGood: {\"title\": \"Fix login button on mobile\"}\\nGood: {\"title\": \"Postgres connection pool exhaustion\"}\\nGood: {\"title\": \"Friendly greeting\"}\\nToo vague: {\"title\": \"Code changes\"}\\nToo long: {\"title\": \"Investigate and fix the issue where the login button does not respond on mobile devices\"}\\n\\nReply with JSON only: {\"title\": \"...\"}'}, {'role': 'user', 'content': 'Reply with exactly: USER-ATTRIBUTION-TEST-OK'}]","llm.openai.model":"Qwen3-8B-128K-Q4_K_M","llm.openai.object":"chat.completion","llm.openai.reasoning_effort":"none","llm.openai.response_format":"{'type': 'json_schema', 'json_schema': {'name': 'session_title', 'strict': True, 'schema': {'type': 'object', 'properties': {'title': {'type': 'string'}}, 'required': ['title'], 'additionalProperties': False}}}","llm.openai.system_fingerprint":"b10964-b29c606e2","llm.openai.timings":"{'cache_n': 0, 'prompt_n': 251, 'prompt_ms': 132.211, 'prompt_per_token_ms': 0.5267370517928287, 'prompt_per_second': 1898.4804592658702, 'predicted_n': 10, 'predicted_ms': 157.43, 'predicted_per_token_ms': 17.492222222222225, 'predicted_per_second': 57.16826526075081}","llm.openai.usage":"{'completion_tokens': 10, 'prompt_tokens': 251, 'total_tokens': 261, 'prompt_tokens_details': {'cached_tokens': 0}}"},"end_time":1795142781899408128,"kind":"SPAN_KIND_INTERNAL","status":{"message":"","code":"STATUS_CODE_OK"},"start_time":1795142780787863040}
{"trace_id":"7579d2309b7b908a271a3eba804f8142","span_id":"a8be42803dcb89e8","parent_span_id":"5aeebc9104ccc27b","name":"litellm_request","attributes":{"gen_ai.cost.discount_amount":0,"gen_ai.cost.discount_percent":0,"gen_ai.cost.input_cost":0,"gen_ai.cost.margin_fixed_amount":0,"gen_ai.cost.margin_percent":0,"gen_ai.cost.margin_total_amount":0,"gen_ai.cost.original_cost":0,"gen_ai.cost.output_cost":0,"gen_ai.cost.tool_usage_cost":0,"gen_ai.cost.total_cost":0,"gen_ai.input.messages":"[{\"role\": \"system\", \"parts\": [{\"type\": \"text\", \"content\": \"You name chat sessions. Given the user's opening message, write a title that lets them find this conversation again in a list.\\n\\nRules:\\n- 3 to 7 words, sentence case (capitalize only the first word and proper nouns).\\n- Name what the user wants DONE, not that they asked a question.\\n- Keep technical terms, filenames, numbers, and error codes exact.\\n- Drop filler words: the, this, my, a, an.\\n- No trailing punctuation, no quotes, no tool names, no 'Title:' prefix.\\n- Never answer the message. Name it.\\n- Always produce something, even for a bare greeting.\\n- Write the title in the same language as the user's message.\\nGood: {\\\"title\\\": \\\"Fix login button on mobile\\\"}\\nGood: {\\\"title\\\": \\\"Postgres connection pool exhaustion\\\"}\\nGood: {\\\"title\\\": \\\"Friendly greeting\\\"}\\nToo vague: {\\\"title\\\": \\\"Code changes\\\"}\\nToo long: {\\\"title\\\": \\\"Investigate and fix the issue where the login button does not respond on mobile devices\\\"}\\n\\nReply with JSON only: {\\\"title\\\": \\\"...\\\"}\"}]}, {\"role\": \"user\", \"parts\": [{\"type\": \"text\", \"content\": \"Reply with exactly: USER-ATTRIBUTION-TEST-OK\"}]}]","gen_ai.operation.name":"acompletion","gen_ai.output.messages":"[{\"role\": \"assistant\", \"parts\": [{\"type\": \"text\", \"content\": \"{\\\"title\\\": \\\"User Attribution Test Ok\\\"}\"}], \"finish_reason\": \"stop\"}]","gen_ai.request.model":"Qwen3-8B-128K-Q4_K_M","gen_ai.response.finish_reasons":"[\"stop\"]","gen_ai.response.id":"chatcmpl-RAboMB3lmMRSz7OJdv8Euo8x3a4AhdVh","gen_ai.response.model":"qwen3-8b","gen_ai.system":"openai","gen_ai.usage.input_tokens":251,"gen_ai.usage.output_tokens":10,"gen_ai.usage.total_tokens":261,"hidden_params":"{\"model_id\": \"765c41514fba499aba470966e5dd3bd9b40fd3ea2463a05adc2ceb602cbe0435\", \"cache_key\": null, \"api_base\": \"http://172.27.176.1:18434/v1\", \"response_cost\": 0.0, \"additional_headers\": {\"llm_provider-server\": \"llama.cpp\", \"llm_provider-access-control-allow-origin\": \"\", \"llm_provider-x-accel-buffering\": \"no\", \"llm_provider-content-type\": \"application/json; charset=utf-8\", \"llm_provider-transfer-encoding\": \"chunked\", \"llm_provider-keep-alive\": \"timeout=5, max=100\", \"x-litellm-model-group\": \"qwen3-8b\", \"x-litellm-attempted-retries\": 0, \"x-litellm-attempted-fallbacks\": 0}, \"litellm_overhead_time_ms\": 6.8831, \"batch_models\": null, \"batch_successful_requests\": null, \"batch_failed_requests\": null, \"litellm_model_name\": \"openai/Qwen3-8B-128K-Q4_K_M\", \"usage_object\": null}","http.route":"/v1/chat/completions","litellm.cache_hit":false,"litellm.call_id":"1693ceba-3eec-456e-be7d-ee5dbe2f25cd","litellm.model_group":"qwen3-8b","litellm.provider.model":"openai/Qwen3-8B-128K-Q4_K_M","llm.is_streaming":"False","llm.request.type":"acompletion","metadata.applied_guardrails":"[]","metadata.cold_storage_object_key":"","metadata.kubernetes_pod_routing":"","metadata.mcp_tool_call_metadata":"","metadata.prompt_management_metadata":"","metadata.requester_custom_headers":"{'x-stainless-lang': 'python', 'x-stainless-package-version': '2.24.0', 'x-stainless-os': 'Windows', 'x-stainless-arch': 'other:amd64', 'x-stainless-runtime': 'CPython', 'x-stainless-runtime-version': '3.14.7', 'x-stainless-async': 'false', 'x-stainless-retry-count': '0', 'x-stainless-read-timeout': '30.0'}","metadata.requester_ip_address":"10.89.1.1","metadata.requester_metadata":"{'trace_id': '7579d2309b7b908a271a3eba804f8142', 'headers': {'host': 'localhost:4000', 'accept-encoding': 'gzip, deflate', 'connection': 'keep-alive', 'accept': 'application/json', 'content-type': 'application/json', 'user-agent': 'OpenAI/Python 2.24.0', 'x-stainless-lang': 'python', 'x-stainless-package-version': '2.24.0', 'x-stainless-os': 'Windows', 'x-stainless-arch': 'other:amd64', 'x-stainless-runtime': 'CPython', 'x-stainless-runtime-version': '3.14.7', 'x-stainless-async': 'false', 'x-stainless-retry-count': '0', 'x-stainless-read-timeout': '30.0', 'content-length': '1358'}, 'used_client_oauth_token': False}","metadata.routing_decision":"","metadata.spend_logs_metadata":"","metadata.team_alias":"","metadata.team_id":"","metadata.usage_object":"{'completion_tokens': 10, 'prompt_tokens': 251, 'total_tokens': 261, 'completion_tokens_details': None, 'prompt_tokens_details': {'audio_tokens': None, 'cached_tokens': 0, 'text_tokens': None, 'image_tokens': None, 'video_tokens': None, 'initial_prompt_tokens': None}}","metadata.used_client_oauth_token":false,"metadata.user_agent":"OpenAI/Python 2.24.0","metadata.user_api_key_alias":"USER_KEY","metadata.user_api_key_auth_metadata":"{}","metadata.user_api_key_budget_reset_at":"","metadata.user_api_key_end_user_id":"","metadata.user_api_key_hash":"f503df9d04b9d92f2333e8999095ea2f92ae33e3162938cde422d46595129c16","metadata.user_api_key_max_budget":"","metadata.user_api_key_org_alias":"","metadata.user_api_key_org_id":"","metadata.user_api_key_project_alias":"","metadata.user_api_key_project_id":"","metadata.user_api_key_request_route":"/v1/chat/completions","metadata.user_api_key_spend":0,"metadata.user_api_key_team_alias":"","metadata.user_api_key_team_id":"","metadata.user_api_key_team_max_budget":"","metadata.user_api_key_team_spend":"","metadata.user_api_key_user_email":"","metadata.user_api_key_user_id":"default_user_id","metadata.user_api_key_user_max_budget":"","metadata.user_api_key_user_spend":0,"metadata.